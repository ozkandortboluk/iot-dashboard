{
  "name": "nexusnode-iot",
  "private": true,
  "version": "1.41.4",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "migrate": "tsx scripts/run-migrations.ts",
    "generate-recovery-token": "tsx scripts/generate-recovery-token.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "verify:schema": "tsx scripts/verify-schema-drift.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint . && tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "test": "vitest run src/",
    "test:watch": "vitest src/",
    "test:load": "tsx scripts/telemetry-load-test.ts",
    "test:e2e": "vitest run e2e/",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:ci": "npm run lint && npm run type-check && npm run test && npm run build && npm run test:smoke && npm run test:e2e",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@yudiel/react-qr-scanner": "^2.6.0",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.2.8",
    "recharts": "^3.10.1",
    "semver": "^7.8.5",
    "vite": "^6.2.3",
    "ws": "^8.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/busboy": "^1.5.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.21.0",
    "@types/semver": "^7.8.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
