# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL / TimescaleDB connection string for primary high-performance time-series database.
# Format: postgresql://username:password@hostname:5432/iot_dashboard_db?sslmode=disable
DATABASE_URL=postgresql://iot_admin:GizliSifreniz123!@localhost:5432/iot_dashboard_db?sslmode=disable

# DB_ENGINE: Primary active database engine ('postgres' | 'firestore-hybrid' | 'local')
# Default: 'postgres'
DB_ENGINE=postgres

# TIMESCALE_COMPRESS_DAYS: Automatic chunk compression threshold in days (Default: 7)
TIMESCALE_COMPRESS_DAYS=7

# TIMESCALE_RETENTION_DAYS: Automatic raw data drop retention policy in days (Default: 90)
TIMESCALE_RETENTION_DAYS=90

# ENABLE_SIMULATOR: Enable virtual device telemetry background simulator (Default: false in production)
ENABLE_SIMULATOR=false

# ENABLE_TEST_ACCOUNT: Enable canonical test account (usr_test_admin / dev_test_01) in production (Default: false)
ENABLE_TEST_ACCOUNT=false

# OTA_SIGNING_KEY_ID: Ed25519 active signing key identifier for hardware Root-of-Trust matching (Default: root_ed25519_v1)
OTA_SIGNING_KEY_ID=root_ed25519_v1

# OTA_SIGNING_PRIVATE_KEY_PATH: Path to Ed25519 private key PEM file for firmware signing.
# Recommended: Read-only Docker secret path (/run/secrets/ota_signing_key) or protected file
OTA_SIGNING_PRIVATE_KEY_PATH=/run/secrets/ota_signing_key

# OTA_SIGNING_PRIVATE_KEY: Optional direct PEM string of Ed25519 private key.
# OTA_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."

# OTA_TRANSITIONAL_PUBLIC_KEYS_JSON: Optional JSON array of transitional/historical public keys for key rotation
# OTA_TRANSITIONAL_PUBLIC_KEYS_JSON='[{"keyId":"root_ed25519_v1","publicKeyPem":"-----BEGIN PUBLIC KEY-----\n..."}]'

# FIRST RUN DATABASE SETUP WIZARD & DOCKER COMPOSE CONFIGURATION:
# POSTGRES_USER: PostgreSQL username for TimescaleDB container (Default: iot_user)
POSTGRES_USER=iot_user
# POSTGRES_PASSWORD: Strong password for TimescaleDB database (Required for Docker compose)
POSTGRES_PASSWORD=nexus_iot_secure_pass_2026
# POSTGRES_DB: Database name (Default: iot_dashboard)
POSTGRES_DB=iot_dashboard
# POSTGRES_PORT_BIND: Localhost bind for PostgreSQL port (Default: 127.0.0.1:5432:5432)
POSTGRES_PORT_BIND=127.0.0.1:5432:5432
# SETUP_REQUIRED: Explicitly forces First Run Database Setup Wizard mode (true/false)
# SETUP_REQUIRED=false



