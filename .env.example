# Public application URL
APP_URL=https://www.nexusnodeiot.com.tr

# Optional Gemini integration. Leave empty when unused.
GEMINI_API_KEY=

# PostgreSQL / TimescaleDB
# Keep the real password only in the VPS .env file. Never commit it.
POSTGRES_USER=iot_user
POSTGRES_PASSWORD=
POSTGRES_DB=iot_dashboard
DB_HOST=timescaledb
DB_PORT=5432
DB_ENGINE=postgres

# DATABASE_URL is optional because the application can build the connection
# from the structured variables above. If used inside Docker, the host must be
# "timescaledb", not localhost, and special password characters must be URL encoded.
# DATABASE_URL=postgresql://iot_user:URL_ENCODED_PASSWORD@timescaledb:5432/iot_dashboard?sslmode=disable

# Bind application, PostgreSQL and Adminer to the VPS loopback interface.
# Nginx reaches app/adminer over the private Docker network.
PORT_BIND=127.0.0.1:3000:3000
POSTGRES_PORT_BIND=127.0.0.1:5432:5432
ADMINER_PORT_BIND=127.0.0.1:8080:8080

# Path to the Adminer HTTP Basic Auth file on the VPS.
# Create it before starting the proxy; see docs/VPS_DEPLOYMENT.md.
ADMINER_HTPASSWD_PATH=/etc/nexusnode/adminer.htpasswd

TIMESCALE_COMPRESS_DAYS=7
TIMESCALE_RETENTION_DAYS=90
ENABLE_SIMULATOR=false
ENABLE_TEST_ACCOUNT=false

# Set true only during the first-run database wizard. Change to false after
# migrations and the real administrator account are complete.
SETUP_REQUIRED=true

OTA_SIGNING_KEY_ID=root_ed25519_v1
OTA_SIGNING_PRIVATE_KEY_PATH=/run/secrets/ota_signing_key
# OTA_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
# OTA_TRANSITIONAL_PUBLIC_KEYS_JSON='[{"keyId":"root_ed25519_v1","publicKeyPem":"-----BEGIN PUBLIC KEY-----\n..."}]'
