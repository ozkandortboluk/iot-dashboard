# ==============================================================================
# NexusNode IoT Cloud - Platform Environment Configuration (.env.example)
# ==============================================================================
# NOT: Üretim (Production) ortamında hassas parolalar ve API anahtarları (POSTGRES_PASSWORD,
# RESEND_API_KEY, SMTP_PASS, Bot Tokenlar vb.) .env dosyasında saklanmak zorunda değildir.
# Tüm hassas sırlar platformun AES-256-GCM Gizli Kasa (Vault) altyapısı veya
# Web Kurulum Sihirbazı (/setup) üzerinden güvenle yönetilir.
# ==============================================================================

# ENCRYPTION_KEY: 32-byte (veya 64-karakter hex) AES-256-GCM Kasa Anahtarı.
# Üretim ortamında zorunludur. Alternatif olarak Docker Secret (/run/secrets/encryption_key)
# veya data/.vault_key dosyasında saklanabilir.
ENCRYPTION_KEY=

# GEMINI_API_KEY: Gemini AI API çağrıları için gereklidir.
# AI Studio ortamı runtime'da otomatik enjekte eder.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Uygulamanın yayınlandığı URL adresi.
# AI Studio veya Cloud Run ortamı runtime'da otomatik enjekte eder.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL / TimescaleDB bağlantı adresi şablonu.
# Format: postgresql://username:password@hostname:5432/iot_dashboard_db?sslmode=disable
# Not: Gerçek veritabanı parolasını .env dosyasında tutmak yerine Vault kasasına kaydedebilirsiniz.
DATABASE_URL=postgresql://iot_user:GUCLU_PAROLANIZ_BURAYA@timescaledb:5432/iot_dashboard?sslmode=disable

# DB_ENGINE: Birincil aktif veritabanı motoru ('postgres' | 'firestore-hybrid' | 'local')
DB_ENGINE=postgres

# TIMESCALE_COMPRESS_DAYS: Otomatik TimescaleDB chunk sıkıştırma eşiği (Gün) (Varsayılan: 7)
TIMESCALE_COMPRESS_DAYS=7

# TIMESCALE_RETENTION_DAYS: Otomatik ham sensör verisi saklama süresi (Gün) (Varsayılan: 90)
TIMESCALE_RETENTION_DAYS=90

# ENABLE_SIMULATOR: Sanal cihaz telemetri simülatörünü aktif eder (Üretimde varsayılan: false)
ENABLE_SIMULATOR=false

# ENABLE_TEST_ACCOUNT: Üretimde standart test hesabını aktif eder (usr_test_admin / dev_test_01) (Varsayılan: false)
ENABLE_TEST_ACCOUNT=false

# OTA_SIGNING_KEY_ID: Ed25519 aktif firmware imzalama anahtarı kimliği (Varsayılan: root_ed25519_v1)
OTA_SIGNING_KEY_ID=root_ed25519_v1

# OTA_SIGNING_PRIVATE_KEY_PATH: Ed25519 özel imzalama anahtarı PEM dosya yolu.
# Tavsiye edilen: Docker Secret (/run/secrets/ota_signing_key) veya Vault kasası
OTA_SIGNING_PRIVATE_KEY_PATH=/run/secrets/ota_signing_key

# POSTGRES DOCKER CONTAINER İLK KURULUM PARAMETRELERİ:
# POSTGRES_USER: TimescaleDB konteyner kullanıcı adı (Varsayılan: iot_user)
POSTGRES_USER=iot_user
# POSTGRES_INIT_PASSWORD: Yalnızca TimescaleDB konteyneri ilk volume oluştururken kullanılır.
# Uygulamanın runtime veritabanı parolası Kasa (Vault) üzerinden okunur.
POSTGRES_INIT_PASSWORD=GUCLU_VERITABANI_PAROLANIZ
POSTGRES_PASSWORD=GUCLU_VERITABANI_PAROLANIZ
POSTGRES_DB=iot_dashboard
POSTGRES_PORT_BIND=127.0.0.1:5432:5432

# BİLDİRİM VE TRASACTIONAL E-POSTA SERVİSİ:
# RESEND_API_KEY: Resend API Anahtarı (re_...).
# Tanımlanmadığında platform e-postaları güvenli simülasyon modunda işler.
# NOT: Üretimde Vault kasası (email.resendApiKey) üzerinden yönetilebilir.
RESEND_API_KEY=re_your_resend_api_key_here

# EMAIL_FROM: Doğrulanmış gönderici e-posta adresi (örn: bildirim@nexusnodeiot.com.tr)
EMAIL_FROM=bildirim@nexusnodeiot.com.tr

# APP_BASE_URL: Parola sıfırlama bağlantıları için uygulamanın genel adresi
APP_BASE_URL=https://nexusnodeiot.com.tr





