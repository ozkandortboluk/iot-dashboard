[Unit]
Description=VPS Agent read-only health audit (example only)
After=network.target
ConditionPathExists=/etc/vps-agent/monitor.json

[Service]
Type=oneshot
User=vps-agent
Group=vps-agent
UMask=0077
# Configure secrets using a protected environment source; do not put tokens in this unit.
# EnvironmentFile=/etc/vps-agent/agent.env
# Packaging must provide the built CLI before this example can be installed.
ExecStart=/usr/bin/node /opt/vps-agent/current/dist/cli.js --config /etc/vps-agent/monitor.json
# Append --allow-telegram-send only after explicitly enabling and approving Telegram delivery.
# Append --allow-ai-analysis only after explicitly enabling and approving external AI diagnosis.
TimeoutStartSec=2min
RuntimeDirectory=vps-agent
RuntimeDirectoryMode=0700
StateDirectory=vps-agent
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/vps-agent /run/vps-agent
StandardOutput=journal
StandardError=journal
