[Unit]
Description=VPS Agent read-only health audit (example only)
After=network.target
ConditionPathExists=/etc/vps-agent/monitor.json

[Service]
Type=oneshot
User=nexusnode-codex
Group=nexusnode-codex
UMask=0077
# Packaging must provide this executable before this example can be installed.
ExecStart=/opt/nexusnode-codex/current/bin/nexusnode-codex --config /etc/nexusnode-codex/monitor.json
TimeoutStartSec=2min
RuntimeDirectory=nexusnode-codex
RuntimeDirectoryMode=0700
StateDirectory=nexusnode-codex
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/nexusnode-codex /run/nexusnode-codex
StandardOutput=journal
StandardError=journal

# Do not install or enable from this PR. Docker socket, DB secrets and sudo are not granted.
