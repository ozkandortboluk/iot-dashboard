[Unit]
Description=VPS Agent read-only health audit (example only)
After=network.target
ConditionPathExists=/etc/vps-agent/monitor.json

[Service]
Type=oneshot
User=vps-agent
Group=vps-agent
UMask=0077
# Packaging must provide this executable before this example can be installed.
ExecStart=/usr/bin/node /opt/vps-agent/current/dist/cli.js --config /etc/vps-agent/monitor.json
TimeoutStartSec=2min
RuntimeDirectory=vps-agent
RuntimeDirectoryMode=0700
StateDirectory=vps-agent
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/vps-agent /run/vps-agent
StandardOutput=journal
StandardError=journal

# Do not install or enable from this PR. Docker socket, DB secrets and sudo are not granted.
