[Unit]
Description=Daily NexusNode Codex read-only health audit (example only)

[Timer]
OnCalendar=*-*-* 09:00:00 Europe/Istanbul
AccuracySec=1min
Persistent=true
Unit=nexusnode-codex.service

[Install]
WantedBy=timers.target

